# BEGIN claude-managed (eval-scheduler)
0 8 * * * $HOME/.claude/scripts/eval-scheduler.sh >> $HOME/.claude/agent-memory/evals/cron.log 2>&1
# END claude-managed (eval-scheduler)
# BEGIN claude-managed (candidate-scheduler)
0 8 * * * $HOME/.claude/scripts/candidate-scheduler.sh >> $HOME/.claude/agent-memory/candidate-checks/cron.log 2>&1
# END claude-managed (candidate-scheduler)
# BEGIN claude-managed (memory-decay-scheduler)
0 8 * * * $HOME/.claude/scripts/memory-decay-scheduler.sh >> $HOME/.claude/agent-memory/decay-checks/cron.log 2>&1
# END claude-managed (memory-decay-scheduler)
# BEGIN claude-managed (build-cache-scheduler)
0 9 * * 1 $HOME/.claude/scripts/build-cache-scheduler.sh >> $HOME/.claude/agent-memory/build-cache-checks/cron.log 2>&1
# END claude-managed (build-cache-scheduler)
